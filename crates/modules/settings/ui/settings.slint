                            Rectangle {
                                height: 56px;
                                border-radius: Theme.shape-medium;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: Theme.outline-variant;

                                HorizontalLayout {
                                    padding-left: 20px;
