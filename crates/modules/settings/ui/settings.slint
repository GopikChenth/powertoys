import { Button, Switch, ScrollView } from "std-widgets.slint";
import { Theme } from "../../../theme/ui/theme.slint";

// Material 3 Navigation Drawer Item (Pill Active Indicator)
component NavDrawerItem inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> is-active: false;
    callback clicked();

    height: 52px;
    border-radius: 26px;
    background: root.is-active ? Theme.secondary-container : (touch.has-hover ? Theme.surface-container-high : transparent);

    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 14px;
        alignment: start;

        Text {
            text: root.icon;
            font-size: 18px;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: 14px;
            font-weight: root.is-active ? 700 : 500;
            color: root.is-active ? Theme.on-secondary-container : (touch.has-hover ? Theme.on-surface : Theme.on-surface-variant);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    title: "PowerToys for Linux - Settings & Dashboard";
    width: 980px;
    height: 680px;
    background: transparent;
    no-frame: true;
    always-on-top: false;

    in-out property <int> active-tab: 0; // 0: Dashboard, 1: Run, 2: FancyZones, 3: General
    in-out property <bool> run-enabled: true;
    in-out property <bool> fancyzones-enabled: true;
    in-out property <bool> run-calc-enabled: true;
    in-out property <bool> run-windows-enabled: true;
    in-out property <string> active-preset: "3 Columns";
    in-out property <string> status-message: "Configuration active";

    callback toggle-run(bool);
    callback toggle-fancyzones(bool);
    callback toggle-run-calc(bool);
    callback toggle-run-windows(bool);
    callback launch-module(string);
    callback select-preset(string);
    callback save-config();
    callback reset-config();
    callback close-requested();

    // Material 3 Base Surface Container
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface;
        border-radius: Theme.shape-large;
        border-width: 1px;
        border-color: Theme.outline-variant;
        clip: true;

        VerticalLayout {
            // Material 3 Top App Bar (64px)
            Rectangle {
                height: 64px;
                background: Theme.surface;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 20px;
                    spacing: 14px;
                    alignment: center;

                    Text {
                        text: "⚡";
                        font-size: 22px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "PowerToys";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.on-surface;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: Theme.surface-container-high;
                        border-width: 1px;
                        border-color: Theme.outline-variant;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            Text {
                                text: "Material 3 • Official UI Library";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.primary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    close-btn := TouchArea {
                        width: 40px;
                        height: 40px;
                        clicked => { root.close-requested(); }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            border-radius: 20px;
                            background: close-btn.has-hover ? Theme.surface-container-high : transparent;
                            Text {
                                text: "✕";
                                font-size: 16px;
                                color: close-btn.has-hover ? Theme.error : Theme.on-surface-variant;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: Theme.outline-variant;
            }

            // Main Content: Navigation Drawer + Content Pane
            HorizontalLayout {
                spacing: 0px;

                // Material 3 Navigation Drawer
                Rectangle {
                    width: 250px;
                    background: Theme.surface-container-low;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;

                        HorizontalLayout {
                            padding-left: 12px;
                            Text {
                                text: "UTILITIES & SYSTEM";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.on-surface-muted;
                            }
                        }

                        NavDrawerItem {
                            text: "Dashboard";
                            icon: "📊";
                            is-active: root.active-tab == 0;
                            clicked => { root.active-tab = 0; }
                        }

                        NavDrawerItem {
                            text: "PowerToys Run";
                            icon: "🔍";
                            is-active: root.active-tab == 1;
                            clicked => { root.active-tab = 1; }
                        }

                        NavDrawerItem {
                            text: "FancyZones";
                            icon: "📐";
                            is-active: root.active-tab == 2;
                            clicked => { root.active-tab = 2; }
                        }

                        NavDrawerItem {
                            text: "General Settings";
                            icon: "⚙️";
                            is-active: root.active-tab == 3;
                            clicked => { root.active-tab = 3; }
                        }

                        Rectangle { vertical-stretch: 1; }

                        // Status badge card
                        Rectangle {
                            height: 44px;
                            border-radius: 12px;
                            background: Theme.surface-container;
                            border-width: 1px;
                            border-color: Theme.outline-variant;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                alignment: center;

                                Text {
                                    text: "●";
                                    font-size: 12px;
                                    color: Theme.success;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "Hyprland IPC Active";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.on-surface-variant;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Vertical Divider
                Rectangle {
                    width: 1px;
                    background: Theme.outline-variant;
                }

                // Main Content Pane
                Rectangle {
                    horizontal-stretch: 1;

                    ScrollView {
                        VerticalLayout {
                            padding: 24px;
                            spacing: 0px;

                            // TAB 0: DASHBOARD
                            if root.active-tab == 0: VerticalLayout {
                                spacing: 16px;

                                // Hero Banner (Material 3 Surface Container High)
                                Rectangle {
                                    height: 80px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container-high;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        spacing: 16px;
                                        alignment: center;

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text {
                                                text: "Dashboard Overview";
                                                font-size: 17px;
                                                font-weight: 700;
                                                color: Theme.on-surface;
                                            }
                                            Text {
                                                text: "Native Material 3 components running on Slint GUI toolkit & Hyprland.";
                                                font-size: 12px;
                                                color: Theme.on-surface-variant;
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        Button {
                                            text: "Save Config";
                                            primary: true;
                                            clicked => { root.save-config(); }
                                        }
                                    }
                                }

                                Text {
                                    text: "Active Utilities";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: Theme.primary;
                                }

                                // Card 1: PowerToys Run
                                Rectangle {
                                    height: 88px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        spacing: 16px;
                                        alignment: center;

                                        Text {
                                            text: "🔍";
                                            font-size: 26px;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Text {
                                                    text: "PowerToys Run";
                                                    font-size: 15px;
                                                    font-weight: 600;
                                                    color: Theme.on-surface;
                                                }
                                                Rectangle {
                                                    height: 20px;
                                                    border-radius: 6px;
                                                    background: Theme.surface-container-high;
                                                    border-width: 1px;
                                                    border-color: Theme.outline-variant;
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        Text {
                                                            text: "Super+Space";
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            color: Theme.primary;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                            Text {
                                                text: "Instant app launcher, window switcher, and math calculator";
                                                font-size: 12px;
                                                color: Theme.on-surface-variant;
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        Button {
                                            text: "Launch Overlay";
                                            clicked => { root.launch-module("run"); }
                                        }

                                        Switch {
                                            checked <=> root.run-enabled;
                                            toggled => { root.toggle-run(self.checked); }
                                        }
                                    }
                                }

                                // Card 2: FancyZones
                                Rectangle {
                                    height: 88px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        spacing: 16px;
                                        alignment: center;

                                        Text {
                                            text: "📐";
                                            font-size: 26px;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Text {
                                                    text: "FancyZones";
                                                    font-size: 15px;
                                                    font-weight: 600;
                                                    color: Theme.on-surface;
                                                }
                                                Rectangle {
                                                    height: 20px;
                                                    border-radius: 6px;
                                                    background: Theme.surface-container-high;
                                                    border-width: 1px;
                                                    border-color: Theme.outline-variant;
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        Text {
                                                            text: "Super+Shift+Z";
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            color: Theme.primary;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                            Text {
                                                text: "Window snapping assistant and grid layout visualizer";
                                                font-size: 12px;
                                                color: Theme.on-surface-variant;
                                            }
                                        }

                                        Rectangle { horizontal-stretch: 1; }

                                        Button {
                                            text: "Launch Editor";
                                            clicked => { root.launch-module("fancyzones"); }
                                        }

                                        Switch {
                                            checked <=> root.fancyzones-enabled;
                                            toggled => { root.toggle-fancyzones(self.checked); }
                                        }
                                    }
                                }

                                Text {
                                    text: "Planned Utilities";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: Theme.on-surface-muted;
                                }

                                // Planned Cards Row
                                HorizontalLayout {
                                    spacing: 14px;

                                    Rectangle {
                                        height: 76px;
                                        horizontal-stretch: 1;
                                        border-radius: Theme.shape-medium;
                                        background: Theme.surface-container-low;
                                        border-width: 1px;
                                        border-color: Theme.outline-variant;

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 14px;
                                            alignment: center;
                                            Text { text: "🎨"; font-size: 22px; }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: "Color Picker"; font-size: 14px; font-weight: 600; color: Theme.on-surface-variant; }
                                                Text { text: "Hex/RGB screen eyedropper"; font-size: 12px; color: Theme.on-surface-muted; }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: "Planned"; font-size: 11px; font-weight: 600; color: Theme.tertiary; }
                                        }
                                    }

                                    Rectangle {
                                        height: 76px;
                                        horizontal-stretch: 1;
                                        border-radius: Theme.shape-medium;
                                        background: Theme.surface-container-low;
                                        border-width: 1px;
                                        border-color: Theme.outline-variant;

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 14px;
                                            alignment: center;
                                            Text { text: "📝"; font-size: 22px; }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: "Text Extractor (OCR)"; font-size: 14px; font-weight: 600; color: Theme.on-surface-variant; }
                                                Text { text: "Instant screen region OCR"; font-size: 12px; color: Theme.on-surface-muted; }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: "Planned"; font-size: 11px; font-weight: 600; color: Theme.tertiary; }
                                        }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; }
                            }

                            // TAB 1: RUN SETTINGS
                            if root.active-tab == 1: VerticalLayout {
                                spacing: 16px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "🔍 PowerToys Run Settings";
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button {
                                        text: "Test Run Overlay";
                                        primary: true;
                                        clicked => { root.launch-module("run"); }
                                    }
                                }

                                Rectangle {
                                    height: 64px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: center;
                                        Text { text: "Enable Math Calculator plugin"; font-size: 14px; color: Theme.on-surface; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Switch {
                                            checked <=> root.run-calc-enabled;
                                            toggled => { root.toggle-run-calc(self.checked); }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 64px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: center;
                                        Text { text: "Search and jump to open Hyprland windows"; font-size: 14px; color: Theme.on-surface; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Switch {
                                            checked <=> root.run-windows-enabled;
                                            toggled => { root.toggle-run-windows(self.checked); }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 64px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: center;
                                        Text { text: "Shell Command Execution (prefix queries with '>')"; font-size: 14px; color: Theme.on-surface; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "Active"; font-size: 12px; font-weight: 600; color: Theme.success; }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; }
                            }

                            // TAB 2: FANCYZONES SETTINGS
                            if root.active-tab == 2: VerticalLayout {
                                spacing: 16px;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "📐 FancyZones Settings";
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button {
                                        text: "Launch Layout Editor";
                                        primary: true;
                                        clicked => { root.launch-module("fancyzones"); }
                                    }
                                }

                                Text {
                                    text: "Default Grid Preset";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.on-surface-variant;
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    Button {
                                        text: "3 Columns";
                                        primary: root.active-preset == "3 Columns";
                                        clicked => { root.select-preset("3 Columns"); }
                                    }

                                    Button {
                                        text: "2x2 Grid";
                                        primary: root.active-preset == "2x2 Grid";
                                        clicked => { root.select-preset("2x2 Grid"); }
                                    }

                                    Button {
                                        text: "Priority Grid";
                                        primary: root.active-preset == "Priority Grid";
                                        clicked => { root.select-preset("Priority Grid"); }
                                    }

                                    Rectangle { horizontal-stretch: 1; }
                                }

                                Rectangle {
                                    height: 64px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: center;
                                        Text { text: "Zone Inner Padding"; font-size: 14px; color: Theme.on-surface; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "8 px"; font-size: 13px; font-weight: 600; color: Theme.primary; }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; }
                            }

                            // TAB 3: GENERAL SETTINGS
                            if root.active-tab == 3: VerticalLayout {
                                spacing: 16px;

                                Text {
                                    text: "⚙️ System & Compositor Information";
                                    font-size: 20px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                }

                                Rectangle {
                                    height: 56px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: center;
                                        Text { text: "UI Library"; font-size: 14px; color: Theme.on-surface-variant; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "Slint Material 3 Standard Widgets"; font-size: 13px; font-weight: 600; color: Theme.primary; }
                                    }
                                }

                                Rectangle {
                                    height: 56px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: center;
                                        Text { text: "Compositor Target"; font-size: 14px; color: Theme.on-surface-variant; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "Hyprland IPC (Native Wayland)"; font-size: 13px; font-weight: 600; color: Theme.success; }
                                    }
                                }

                                Rectangle {
                                    height: 56px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: center;
                                        Text { text: "CPU Microarchitecture"; font-size: 14px; color: Theme.on-surface-variant; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "x86-64-v3 (AVX2, FMA, BMI1/2)"; font-size: 13px; font-weight: 600; color: Theme.primary; }
                                    }
                                }

                                Rectangle {
                                    height: 56px;
                                    border-radius: Theme.shape-medium;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        alignment: center;
                                        Text { text: "Configuration File"; font-size: 14px; color: Theme.on-surface-variant; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "~/.config/powertoys/config.json"; font-size: 13px; color: Theme.secondary; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: start;

                                    Button {
                                        text: "Reset to Defaults";
                                        clicked => { root.reset-config(); }
                                    }

                                    Button {
                                        text: "Save Configuration";
                                        primary: true;
                                        clicked => { root.save-config(); }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}
