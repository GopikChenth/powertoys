import { Button } from "std-widgets.slint";
import { Theme } from "../../../theme/ui/theme.slint";

export struct ZoneRect {
    id: int,
    x-percent: float,
    y-percent: float,
    width-percent: float,
    height-percent: float,
    label: string,
}

export component FancyZonesEditor inherits Window {
    title: "FancyZones Layout Editor";
    width: 840px;
    height: 560px;
    background: transparent;
    no-frame: true;
    always-on-top: true;

    in-out property <[ZoneRect]> zones: [
        { id: 1, x-percent: 0.0, y-percent: 0.0, width-percent: 0.333, height-percent: 1.0, label: "Zone 1 (Left)" },
        { id: 2, x-percent: 0.333, y-percent: 0.0, width-percent: 0.334, height-percent: 1.0, label: "Zone 2 (Center Master)" },
        { id: 3, x-percent: 0.667, y-percent: 0.0, width-percent: 0.333, height-percent: 1.0, label: "Zone 3 (Right)" }
    ];

    in-out property <string> active-preset: "3 Columns";
    callback preset-selected(string);
    callback zone-clicked(int);
    callback close-requested();

    // Material 3 Surface
    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface;
        border-radius: Theme.shape-large;
        border-width: 1px;
        border-color: Theme.outline-variant;
        clip: true;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            // Header Top App Bar
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Text {
                    text: "📐";
                    font-size: 22px;
                    vertical-alignment: center;
                }

                Text {
                    text: "FancyZones Layout Manager";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.on-surface;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                close-touch := TouchArea {
                    width: 36px;
                    height: 36px;
                    clicked => { root.close-requested(); }
                    Rectangle {
                        border-radius: 18px;
                        background: close-touch.has-hover ? Theme.surface-container-high : transparent;
                        Text {
                            text: "✕";
                            font-size: 16px;
                            color: close-touch.has-hover ? Theme.error : Theme.on-surface-variant;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: Theme.outline-variant;
            }

            // Preset Buttons Bar (Using official Material Button widgets)
            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: "3 Columns";
                    primary: root.active-preset == "3 Columns";
                    clicked => { root.preset-selected("3 Columns"); }
                }

                Button {
                    text: "2x2 Grid";
                    primary: root.active-preset == "2x2 Grid";
                    clicked => { root.preset-selected("2x2 Grid"); }
                }

                Button {
                    text: "Priority Grid";
                    primary: root.active-preset == "Priority Grid";
                    clicked => { root.preset-selected("Priority Grid"); }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            // Interactive Screen Canvas Preview (M3 Container Lowest)
            preview-box := Rectangle {
                vertical-stretch: 1;
                background: Theme.surface-container-lowest;
                border-radius: Theme.shape-medium;
                border-width: 1px;
                border-color: Theme.outline-variant;

                for z in root.zones: Rectangle {
                    x: parent.width * z.x-percent + 8px;
                    y: parent.height * z.y-percent + 8px;
                    width: parent.width * z.width-percent - 16px;
                    height: parent.height * z.height-percent - 16px;

                    background: zone-touch.has-hover ? Theme.primary-container : Theme.surface-container-high;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: zone-touch.has-hover ? Theme.primary : Theme.outline-variant;

                    animate background { duration: 150ms; }

                    zone-touch := TouchArea {
                        clicked => { root.zone-clicked(z.id); }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: "{" + z.id + "}";
                            font-size: 24px;
                            font-weight: 700;
                            color: zone-touch.has-hover ? Theme.on-primary-container : Theme.primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: z.label;
                            font-size: 12px;
                            font-weight: 500;
                            color: zone-touch.has-hover ? Theme.on-primary-container : Theme.on-surface-variant;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Footer
            HorizontalLayout {
                Text {
                    text: "💡 Drag any window while holding Shift to snap, or click a zone to apply to active window.";
                    font-size: 12px;
                    color: Theme.on-surface-muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}
