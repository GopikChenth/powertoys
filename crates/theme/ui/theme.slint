export global Theme {
    // Material 3 Dark Surface Containers
    out property <color> surface: #141218;                  // Base surface
    out property <color> surface-dim: #110F14;
    out property <color> surface-container-lowest: #0F0D13;
    out property <color> surface-container-low: #1D1B20;    // Nav drawer / sidebar
    out property <color> surface-container: #211F26;        // Standard cards
    out property <color> surface-container-high: #2B2930;   // Hover / elevated cards
    out property <color> surface-container-highest: #36343B;// Switch track / text inputs

    // Material 3 Primary Roles (M3 Lavender/Purple)
    out property <color> primary: #D0BCFF;
    out property <color> on-primary: #381E72;
    out property <color> primary-container: #4F378B;
    out property <color> on-primary-container: #EADDFF;

    // Material 3 Secondary Roles
    out property <color> secondary: #CCC2DC;
    out property <color> on-secondary: #332D41;
    out property <color> secondary-container: #4A4458;      // Nav active pill / tonal button
    out property <color> on-secondary-container: #E8DEF8;

    // Material 3 Tertiary Roles
    out property <color> tertiary: #EFB8C8;
    out property <color> on-tertiary: #492532;
    out property <color> tertiary-container: #633B48;
    out property <color> on-tertiary-container: #FFD8E4;

    // Material 3 Error & Status
    out property <color> error: #F2B8B5;
    out property <color> on-error: #601410;
    out property <color> success: #A6E3A1;
    out property <color> warning: #F9E2AF;

    // Material 3 Outlines
    out property <color> outline: #938F99;                  // Unchecked switch border, outlined button
    out property <color> outline-variant: #49454F;          // Card borders, list dividers

    // Material 3 Typography Colors
    out property <color> on-surface: #E6E0E9;               // High-emphasis text
    out property <color> on-surface-variant: #CAC4D0;       // Medium-emphasis text
    out property <color> on-surface-muted: #79747E;         // Disabled / hint text

    // Material 3 Corner Shapes
    out property <length> shape-full: 9999px;               // Pill shapes (buttons, chips, switches)
    out property <length> shape-extra-large: 28px;          // Search bar, nav drawer pills
    out property <length> shape-large: 24px;                // Large cards
    out property <length> shape-medium: 16px;               // Standard cards
    out property <length> shape-small: 8px;                 // Assist / filter chips

    // Backwards compatibility aliases for existing module code
    out property <color> background: #141218;
    out property <color> surface-hover: #2B2930;
    out property <color> surface-active: #4A4458;
    out property <color> accent: #D0BCFF;
    out property <color> accent-hover: #EADDFF;
    out property <color> accent-secondary: #EFB8C8;
    out property <color> border: #49454F;
    out property <color> border-focused: #D0BCFF;
    out property <length> border-radius: 16px;
    out property <length> border-radius-sm: 8px;
    out property <color> text-primary: #E6E0E9;
    out property <color> text-secondary: #CAC4D0;
    out property <color> text-muted: #79747E;
    out property <color> text-accent: #381E72;
    out property <length> font-title: 20px;
    out property <length> font-body: 14px;
    out property <length> font-small: 12px;
}
