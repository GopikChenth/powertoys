export component MainWindow inherits Window {
    title: "PowerToys";

    callback close-requested();

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: "PowerToys";
                font-size: 32px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: "Empty Application (Fullscreen)";
                font-size: 16px;
                color: #888888;
                horizontal-alignment: center;
            }

            Text {
                text: "Press Escape to exit";
                font-size: 12px;
                color: #555555;
                horizontal-alignment: center;
            }
        }
    }
}
