export struct HistoryColor {
    hex: string,
    col: color,
}

component ColorSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <color> end-color: #ff0000;
    in property <brush> track-background: @linear-gradient(90deg, #000000, root.end-color);
    callback value-changed(float);

    height: 18px;

    Rectangle {
        y: (parent.height - 10px) / 2;
        width: 100%;
        height: 10px;
        border-radius: 5px;
        background: root.track-background;
        border-width: 1px;
        border-color: #38343e;
    }

    thumb := Rectangle {
        x: Math.max(0px, Math.min(parent.width - 16px, root.value * (parent.width - 16px)));
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 2px;
        border-color: #18161a;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.value = Math.max(0.0, Math.min(1.0, (self.mouse-x - 8px) / (root.width - 16px)));
            root.value-changed(root.value);
        }
        moved => {
            if self.pressed {
                root.value = Math.max(0.0, Math.min(1.0, (self.mouse-x - 8px) / (root.width - 16px)));
                root.value-changed(root.value);
            }
        }
    }
}

component EditorInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> is-centered: false;
    callback accepted(string);
    callback edited(string);

    height: 30px;
    background: #18161a;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? #b59ee6 : #38343e;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;

        input := TextInput {
            font-size: 13px;
            font-weight: 600;
            color: #f0eff1;
            horizontal-alignment: root.is-centered ? center : left;
            vertical-alignment: center;
            selection-background-color: #b59ee6;
            selection-foreground-color: #141315;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
    }
}

component ColorEditorCard inherits Rectangle {
    in-out property <float> h-val: 0.14;
    in-out property <float> s-val: 0.38;
    in-out property <float> v-val: 0.49;
    in-out property <color> hue-color: #ffcc00;
    in-out property <color> sat-color: #a89433;
    in-out property <string> r-text: "125";
    in-out property <string> g-text: "117";
    in-out property <string> b-text: "78";
    in-out property <string> hex-text: "7d754e";

    callback slider-changed(float, float, float);
    callback rgb-changed(string, string, string);
    callback hex-changed(string);
    callback select-clicked();
    callback close-clicked();

    background: #201d24;
    border-radius: 8px;
    border-width: 1px;
    border-color: #38343e;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000aa;
    drop-shadow-offset-y: 4px;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 12px;
        spacing: 9px;

        // Header with title and close X
        HorizontalLayout {
            alignment: space-between;
            height: 18px;

            Text {
                text: "Adjust Color";
                font-size: 12px;
                font-weight: 600;
                color: #8a888c;
                vertical-alignment: center;
            }

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 3px;
                background: ed_close_touch.has-hover ? #2e2a33 : transparent;

                Text {
                    text: "X";
                    font-size: 10px;
                    font-weight: 600;
                    color: #8a888c;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ed_close_touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.close-clicked(); }
                }
            }
        }

        // H Slider Row
        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: "H";
                font-size: 13px;
                font-weight: 600;
                color: #8a888c;
                width: 18px;
                vertical-alignment: center;
            }

            ColorSlider {
                value: root.h-val;
                track-background: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
                horizontal-stretch: 1;
                value-changed(val) => {
                    root.h-val = val;
                    root.slider-changed(root.h-val, root.s-val, root.v-val);
                }
            }
        }

        // S Slider Row
        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: "S";
                font-size: 13px;
                font-weight: 600;
                color: #8a888c;
                width: 18px;
                vertical-alignment: center;
            }

            ColorSlider {
                value: root.s-val;
                track-background: @linear-gradient(90deg, #888888 0%, root.hue-color 100%);
                horizontal-stretch: 1;
                value-changed(val) => {
                    root.s-val = val;
                    root.slider-changed(root.h-val, root.s-val, root.v-val);
                }
            }
        }

        // V Slider Row
        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: "V";
                font-size: 13px;
                font-weight: 600;
                color: #8a888c;
                width: 18px;
                vertical-alignment: center;
            }

            ColorSlider {
                value: root.v-val;
                track-background: @linear-gradient(90deg, #000000 0%, root.sat-color 100%);
                horizontal-stretch: 1;
                value-changed(val) => {
                    root.v-val = val;
                    root.slider-changed(root.h-val, root.s-val, root.v-val);
                }
            }
        }

        // RGB Input Row
        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: "RGB";
                font-size: 13px;
                font-weight: 600;
                color: #8a888c;
                width: 32px;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                r_in := EditorInput {
                    text: root.r-text;
                    is-centered: true;
                    horizontal-stretch: 1;
                    edited(txt) => { root.rgb-changed(txt, g_in.text, b_in.text); }
                    accepted(txt) => { root.rgb-changed(txt, g_in.text, b_in.text); }
                }

                g_in := EditorInput {
                    text: root.g-text;
                    is-centered: true;
                    horizontal-stretch: 1;
                    edited(txt) => { root.rgb-changed(r_in.text, txt, b_in.text); }
                    accepted(txt) => { root.rgb-changed(r_in.text, txt, b_in.text); }
                }

                b_in := EditorInput {
                    text: root.b-text;
                    is-centered: true;
                    horizontal-stretch: 1;
                    edited(txt) => { root.rgb-changed(r_in.text, g_in.text, txt); }
                    accepted(txt) => { root.rgb-changed(r_in.text, g_in.text, txt); }
                }
            }
        }

        // HEX Input Row
        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            Text {
                text: "HEX";
                font-size: 13px;
                font-weight: 600;
                color: #8a888c;
                width: 32px;
                vertical-alignment: center;
            }

            hex_in := EditorInput {
                text: root.hex-text;
                horizontal-stretch: 1;
                edited(txt) => { root.hex-changed(txt); }
                accepted(txt) => { root.hex-changed(txt); }
            }
        }

        // Select Action Button
        Rectangle {
            height: 34px;
            background: sel_btn_touch.has-hover ? #2b8396 : #1f6473;
            border-radius: 4px;

            Text {
                text: "Select";
                font-size: 14px;
                font-weight: 600;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            sel_btn_touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.select-clicked(); }
            }
        }
    }
}

component SidebarItem inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> is-active: true;
    callback clicked();

    height: 48px;
    background: is-active ? #282629 : (touch.has-hover ? #1f1e21 : transparent);

    animate background { duration: 150ms; }

    // Sharp left active accent line matching Antigravity
    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: root.is-active ? #b59ee6 : transparent;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        alignment: center;

        // Clean vector color swatch
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 2px;
            background: root.is-active ? #b59ee6 : #6e6b72;
        }

        Text {
            text: root.text;
            font-size: 15px;
            font-weight: root.is-active ? 600 : 500;
            color: root.is-active ? #f0eff1 : (touch.has-hover ? #ecebec : #a6a4a8);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SharpButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    callback clicked();

    height: 38px;
    background: primary ? (touch.has-hover ? #c4a7e7 : #b59ee6) : (touch.has-hover ? #2e2b30 : #232125);
    border-width: primary ? 0px : 1px;
    border-color: #38343c;

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.primary ? #141315 : #f0eff1;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}



component SharpInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    callback accepted(string);

    height: 38px;
    background: #1c1a1e;
    border-width: 1px;
    border-color: input.has-focus ? #b59ee6 : #38343c;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        input := TextInput {
            font-size: 14px;
            color: #f0eff1;
            selection-background-color: #b59ee6;
            selection-foreground-color: #141315;
            vertical-alignment: center;
            accepted => { root.accepted(self.text); }
        }
    }
}

component ColorBox inherits Rectangle {
    in property <color> fill-color;
    in property <string> hex-value;
    callback clicked(string);

    width: 44px;
    height: 44px;
    background: root.fill-color;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? #ffffff : #38343c;

    touch := TouchArea {
        clicked => { root.clicked(root.hex-value); }
    }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: true;
    callback toggled(bool);

    width: 44px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? #0078d4 : #28252c;
    border-width: 1px;
    border-color: root.checked ? #0078d4 : #45414d;

    animate background { duration: 150ms; }

    thumb := Rectangle {
        x: root.checked ? parent.width - 19px : 3px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;

        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component KeyBadge inherits Rectangle {
    in property <string> key-text: "";
    in property <bool> is-win-key: false;

    height: 30px;
    background: #0078d4;
    border-radius: 4px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        if root.is-win-key: Rectangle {
            width: 14px;
            height: 14px;

            Rectangle { x: 0px; y: 0px; width: 6px; height: 6px; border-radius: 1px; background: #ffffff; }
            Rectangle { x: 8px; y: 0px; width: 6px; height: 6px; border-radius: 1px; background: #ffffff; }
            Rectangle { x: 0px; y: 8px; width: 6px; height: 6px; border-radius: 1px; background: #ffffff; }
            Rectangle { x: 8px; y: 8px; width: 6px; height: 6px; border-radius: 1px; background: #ffffff; }
        }

        if !root.is-win-key: Text {
            text: root.key-text;
            font-size: 13px;
            font-weight: 600;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
}

