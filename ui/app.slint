export struct HistoryColor {
    hex: string,
    col: color,
}

component SidebarItem inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> is-active: true;
    callback clicked();

    height: 48px;
    background: is-active ? #282629 : (touch.has-hover ? #1f1e21 : transparent);

    animate background { duration: 150ms; }

    // Sharp left active accent line matching Antigravity
    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: root.is-active ? #b59ee6 : transparent;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        alignment: center;

        // Clean vector color swatch
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 2px;
            background: root.is-active ? #b59ee6 : #6e6b72;
        }

        Text {
            text: root.text;
            font-size: 15px;
            font-weight: root.is-active ? 600 : 500;
            color: root.is-active ? #f0eff1 : (touch.has-hover ? #ecebec : #a6a4a8);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SharpButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    callback clicked();

    height: 38px;
    background: primary ? (touch.has-hover ? #c4a7e7 : #b59ee6) : (touch.has-hover ? #2e2b30 : #232125);
    border-width: primary ? 0px : 1px;
    border-color: #38343c;

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.primary ? #141315 : #f0eff1;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ColorFormatRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    callback copy_clicked();

    height: 38px;
    background: #171518;
    border-width: 1px;
    border-color: #27242a;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 12px;
        alignment: stretch;

        // Label Column (Fixed width for tabular alignment)
        Text {
            width: 52px;
            text: root.label;
            font-size: 13px;
            font-weight: 700;
            color: #8a888c;
            vertical-alignment: center;
        }

        // Value Column (Starts at exact same X position)
        Text {
            text: root.value;
            font-size: 14px;
            font-weight: 600;
            color: #f0eff1;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Action Button Column (Uniform 105px width)
        SharpButton {
            width: 105px;
            text: "Copy " + root.label;
            primary: false;
            clicked => { root.copy_clicked(); }
        }
    }
}

component PowerToysPickerCard inherits Rectangle {
    in property <color> fill-color;
    in property <string> hex-value: "a8c7d2";
    in property <string> color-name: "Sky blue";
    callback clicked();

    height: 84px;
    background: touch.has-hover ? #1f1d22 : #171518;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? #38343f : #27242a;

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        alignment: center;

        // Swatch on Left
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 4px;
            background: root.fill-color;
            border-width: 1px;
            border-color: #38343c;
        }

        // Hex Code and Color Name on Right
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.hex-value;
                font-size: 21px;
                font-weight: 700;
                color: #f0eff1;
            }

            Text {
                text: root.color-name;
                font-size: 14px;
                font-weight: 500;
                color: #8a888c;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SharpInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    callback accepted(string);

    height: 38px;
    background: #1c1a1e;
    border-width: 1px;
    border-color: input.has-focus ? #b59ee6 : #38343c;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        input := TextInput {
            font-size: 14px;
            color: #f0eff1;
            selection-background-color: #b59ee6;
            selection-foreground-color: #141315;
            vertical-alignment: center;
            accepted => { root.accepted(self.text); }
        }
    }
}

component ColorBox inherits Rectangle {
    in property <color> fill-color;
    in property <string> hex-value;
    callback clicked(string);

    width: 44px;
    height: 44px;
    background: root.fill-color;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? #ffffff : #38343c;

    touch := TouchArea {
        clicked => { root.clicked(root.hex-value); }
    }
}

component FeatureCard inherits Rectangle {
    background: #1b191d;
    border-width: 1px;
    border-color: #2b282e;
}

export component MainWindow inherits Window {
    title: "PowerToys";
    background: #141315;
    min-width: 800px;
    min-height: 600px;

    in-out property <int> selected-index: 0;
    in-out property <string> shortcut-text: "SUPER + SHIFT + C";
    in-out property <string> current-hex: "#B59EE6";
    in-out property <string> current-hex-clean: "b59ee6";
    in-out property <string> color-name: "Lavender";
    in-out property <string> current-rgb: "rgb(181, 158, 230)";
    in-out property <string> current-hsl: "hsl(259, 58%, 76%)";
    in-out property <string> current-cmyk: "cmyk(21%, 31%, 0%, 10%)";
    in-out property <color> current-color: #b59ee6;
    in-out property <string> status-text: "";
    in-out property <[HistoryColor]> history: [];

    callback close-requested();
    callback pick-color-clicked();
    callback copy-hex-clicked(string);
    callback copy-rgb-clicked(string);
    callback copy-hsl-clicked(string);
    callback copy-cmyk-clicked(string);
    callback save-shortcut-clicked(string);
    callback swatch-selected(string);

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            spacing: 0px;

            // Sidebar (Fixed width)
            Rectangle {
                width: 250px;
                background: #181719;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    // App Header
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-top: 8px;
                        padding-bottom: 12px;
                        spacing: 12px;
                        alignment: center;

                        // Modern Vector Logo Mark
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: transparent;

                            Rectangle { x: 0px; y: 0px; width: 9px; height: 9px; border-radius: 2px; background: #0078d4; }
                            Rectangle { x: 11px; y: 0px; width: 9px; height: 9px; border-radius: 2px; background: #2b8396; }
                            Rectangle { x: 0px; y: 11px; width: 9px; height: 9px; border-radius: 2px; background: #b59ee6; }
                            Rectangle { x: 11px; y: 11px; width: 9px; height: 9px; border-radius: 2px; background: #50e3c2; }
                        }

                        Text {
                            text: "PowerToys";
                            font-size: 20px;
                            font-weight: 700;
                            color: #f0eff1;
                            vertical-alignment: center;
                        }
                    }

                    // Separator
                    Rectangle {
                        height: 1px;
                        background: #252327;
                    }

                    // Navigation Category Label
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-top: 12px;
                        padding-bottom: 4px;
                        Text {
                            text: "MODULES";
                            font-size: 11px;
                            font-weight: 700;
                            color: #8a888c;
                        }
                    }

                    // Module 0: Colour Picker
                    SidebarItem {
                        text: "Colour Picker";
                        is-active: root.selected-index == 0;
                        clicked => { root.selected-index = 0; }
                    }

                    Rectangle { vertical-stretch: 1; }

                    // Footer hint
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 8px;
                        Text {
                            text: "Press Esc to exit";
                            font-size: 12px;
                            color: #6d6b6e;
                        }
                    }
                }
            }

            // Divider Line
            Rectangle {
                width: 1px;
                background: #252327;
            }

            // Main Content Area with mathematically guaranteed right-side padding
            Rectangle {
                horizontal-stretch: 1;
                background: #141315;

                Flickable {
                    x: 36px;
                    y: 32px;
                    width: parent.width - 72px;
                    height: parent.height - 64px;
                    content-width: self.width;
                    content-height: content.preferred-height;

                    content := VerticalLayout {
                        width: parent.width;
                        spacing: 20px;
                        alignment: start;

                            // Header
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Colour Picker";
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: #f0eff1;
                                }

                                Text {
                                    text: "System-wide pixel color inspection and clipboard utility.";
                                    font-size: 13px;
                                    color: #a6a4a8;
                                }
                            }

                            // Action Banner (Sharp Box)
                            FeatureCard {
                                height: 76px;
                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    spacing: 16px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "Pick Any Color On Screen";
                                            font-size: 15px;
                                            font-weight: 600;
                                            color: #f0eff1;
                                        }
                                        Text {
                                            text: "Magnifying loupe freezes screen and captures exact pixel color.";
                                            font-size: 12px;
                                            color: #8a888c;
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    SharpButton {
                                        text: "Pick Color (Hyprpicker)";
                                        primary: true;
                                        clicked => { root.pick-color-clicked(); }
                                    }
                                }
                            }

                            // Shortcut Configuration Section
                            FeatureCard {
                                VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 18px;
                                    padding-bottom: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "Global Activation Shortcut";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: #f0eff1;
                                    }

                                    Text {
                                        text: "Press this shortcut from anywhere in your desktop to trigger Hyprpicker.";
                                        font-size: 12px;
                                        color: #8a888c;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        shortcut-input := SharpInput {
                                            text: root.shortcut-text;
                                            horizontal-stretch: 1;
                                        }

                                        SharpButton {
                                            text: "Save & Apply Shortcut";
                                            primary: false;
                                            clicked => { root.save-shortcut-clicked(shortcut-input.text); }
                                        }
                                    }
                                }
                            }

                            // Active Color Inspector Section
                            FeatureCard {
                                VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 18px;
                                    padding-bottom: 18px;
                                    spacing: 14px;

                                    Text {
                                        text: "Active Color Inspector";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: #f0eff1;
                                    }

                                    // PowerToys Iconic Picker Card (Matching Screenshot)
                                    PowerToysPickerCard {
                                        fill-color: root.current-color;
                                        hex-value: root.current-hex-clean;
                                        color-name: root.color-name;
                                        clicked => { root.copy-hex-clicked(root.current-hex); }
                                    }

                                    // Format Rows Column
                                    VerticalLayout {
                                        spacing: 8px;

                                        ColorFormatRow {
                                            label: "HEX";
                                            value: root.current-hex;
                                            copy_clicked => { root.copy-hex-clicked(root.current-hex); }
                                        }

                                        ColorFormatRow {
                                            label: "RGB";
                                            value: root.current-rgb;
                                            copy_clicked => { root.copy-rgb-clicked(root.current-rgb); }
                                        }

                                        ColorFormatRow {
                                            label: "HSL";
                                            value: root.current-hsl;
                                            copy_clicked => { root.copy-hsl-clicked(root.current-hsl); }
                                        }

                                        ColorFormatRow {
                                            label: "CMYK";
                                            value: root.current-cmyk;
                                            copy_clicked => { root.copy-cmyk-clicked(root.current-cmyk); }
                                        }
                                    }
                                }
                            }

                            // Dynamic Color History Section
                            FeatureCard {
                                VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 18px;
                                    padding-bottom: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "Color History";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #f0eff1;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        for item in root.history: ColorBox {
                                            fill-color: item.col;
                                            hex-value: item.hex;
                                            clicked(hex) => { root.swatch-selected(hex); }
                                        }
                                    }
                                }
                            }

                            // Status / Feedback message
                            if root.status-text != "": Rectangle {
                                background: #1c261e;
                                border-width: 1px;
                                border-color: #2e4a33;
                                height: 36px;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: start;

                                    Text {
                                        text: root.status-text;
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: #a6e3a1;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

component ColorCardItem inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    callback copy_clicked();

    height: 40px;
    background: touch.has-hover ? #28242c : #201d24;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover ? #3d3744 : #2c2832;

    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        alignment: stretch;

        // Label
        Text {
            width: 48px;
            text: root.label;
            font-size: 13px;
            font-weight: 700;
            color: #8a888c;
            vertical-alignment: center;
        }

        // Value
        Text {
            text: root.value;
            font-size: 14px;
            font-weight: 600;
            color: #f0eff1;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        // Copy Icon Button (Fluent overlapping rectangles)
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 4px;
            background: btn_touch.has-hover ? #2e2a34 : transparent;

            Rectangle {
                x: 7px;
                y: 6px;
                width: 10px;
                height: 12px;
                border-width: 1.5px;
                border-color: #8a888c;
                border-radius: 2px;
                background: transparent;
            }

            Rectangle {
                x: 10px;
                y: 9px;
                width: 10px;
                height: 12px;
                border-width: 1.5px;
                border-color: #8a888c;
                border-radius: 2px;
                background: #201d24;
            }

            btn_touch := TouchArea {
                clicked => { root.copy_clicked(); }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.copy_clicked(); }
    }
}

component HistoryDot inherits Rectangle {
    in property <color> fill-color;
    in property <bool> is-active: false;
    callback clicked();

    width: 22px;
    height: 22px;

    // Outer active ring (uses Antigravity purple accent #b59ee6 for active selection)
    if root.is-active: Rectangle {
        x: 0px;
        y: 0px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        border-width: 2px;
        border-color: #b59ee6;
        background: transparent;
    }

    // Inner circle
    Rectangle {
        x: 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.fill-color;
        border-width: 1px;
        border-color: #ffffff18;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ShadeStrip inherits Rectangle {
    in property <color> s1;
    in property <color> s2;
    in property <color> s3;
    in property <color> s4;
    in property <color> s5;
    callback shade_clicked(int);

    width: 18px;
    height: 184px;
    border-radius: 4px;
    clip: true;
    border-width: 1px;
    border-color: #38343e;

    VerticalLayout {
        spacing: 0px;
        Rectangle { height: 36px; background: root.s1; TouchArea { clicked => { root.shade_clicked(0); } } }
        Rectangle { height: 37px; background: root.s2; TouchArea { clicked => { root.shade_clicked(1); } } }
        Rectangle { height: 38px; background: root.s3; TouchArea { clicked => { root.shade_clicked(2); } } }
        Rectangle { height: 37px; background: root.s4; TouchArea { clicked => { root.shade_clicked(3); } } }
        Rectangle { height: 36px; background: root.s5; TouchArea { clicked => { root.shade_clicked(4); } } }
    }
}

export component PickerPopupWindow inherits Window {
    title: "Color Picker";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: 440px;
    height: 350px;

    in-out property <string> hex: "9cb687";
    in-out property <string> rgb: "rgb(156, 182, 135)";
    in-out property <string> hsl: "hsl(93, 24%, 62%)";
    in-out property <string> hsv: "hsv(93, 26%, 71%)";
    in-out property <color> current-color: #9cb687;
    in-out property <[HistoryColor]> history: [];
    in-out property <[color]> shades: [#b8cfab, #abc39c, #9cb687, #819b6e, #677e55];
    in-out property <bool> show-copied-toast: true;

    callback close-requested();
    callback pick-requested();
    callback settings-requested();
    callback copy-hex();
    callback copy-rgb();
    callback copy-hsl();
    callback copy-hsv();
    callback select-swatch(string);
    callback select-shade(int);

    Rectangle {
        width: 100%;
        height: 100%;
        background: #18161a;
        border-radius: 10px;
        border-width: 1px;
        border-color: #2e2a33;
        clip: true;

        // Titlebar
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 36px;
            background: #18161a;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                alignment: stretch;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        background: #0078d4;
                        border-radius: 3px;
                        y: 10px;

                        Rectangle {
                            x: 4px;
                            y: 4px;
                            width: 8px;
                            height: 8px;
                            border-radius: 1px;
                            background: #ffffff;
                        }
                    }

                    Text {
                        text: "Color Picker";
                        font-size: 13px;
                        font-weight: 600;
                        color: #f0eff1;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    width: 26px;
                    height: 26px;
                    y: 5px;
                    border-radius: 4px;
                    background: close_touch.has-hover ? #2e2a33 : transparent;

                    Text {
                        text: "X";
                        font-size: 11px;
                        font-weight: 600;
                        color: #8a888c;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close_touch := TouchArea {
                        clicked => { root.close-requested(); }
                    }
                }
            }
        }

        // Toolbar
        Rectangle {
            x: 0px;
            y: 36px;
            width: 100%;
            height: 44px;
            background: #18161a;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: center;

                // Pick Button
                Rectangle {
                    width: 76px;
                    height: 30px;
                    background: pick_touch.has-hover ? #2f2b34 : #242127;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #38343e;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 2px;
                            background: #b59ee6;
                        }

                        Text {
                            text: "Pick";
                            font-size: 13px;
                            font-weight: 600;
                            color: #f0eff1;
                            vertical-alignment: center;
                        }
                    }

                    pick_touch := TouchArea {
                        clicked => { root.pick-requested(); }
                    }
                }

                // History Dots Row
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    horizontal-stretch: 1;

                    for item[i] in root.history: HistoryDot {
                        fill-color: item.col;
                        is-active: i == 0;
                        clicked => { root.select-swatch(item.hex); }
                    }
                }

                // Settings Button (Vector 3-dots)
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 4px;
                    background: set_touch.has-hover ? #28242c : transparent;

                    HorizontalLayout {
                        spacing: 3px;
                        alignment: center;

                        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: #8a888c; }
                        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: #8a888c; }
                        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: #8a888c; }
                    }

                    set_touch := TouchArea {
                        clicked => { root.settings-requested(); }
                    }
                }
            }
        }

        // Handle Bar below Toolbar
        Rectangle {
            x: 150px;
            y: 78px;
            width: 140px;
            height: 2px;
            border-radius: 1px;
            background: #38343e;
        }

        // Separator Line
        Rectangle {
            x: 0px;
            y: 84px;
            width: 100%;
            height: 1px;
            background: #27242a;
        }

        // Main Content: Shades + Format Cards
        Rectangle {
            x: 0px;
            y: 85px;
            width: 100%;
            height: 221px;
            background: #18161a;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 12px;
                alignment: stretch;

                ShadeStrip {
                    s1: root.shades[0];
                    s2: root.shades[1];
                    s3: root.shades[2];
                    s4: root.shades[3];
                    s5: root.shades[4];
                    shade_clicked(idx) => { root.select-shade(idx); }
                }

                VerticalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;

                    ColorCardItem {
                        label: "HEX";
                        value: root.hex;
                        copy_clicked => { root.copy-hex(); }
                    }

                    ColorCardItem {
                        label: "RGB";
                        value: root.rgb;
                        copy_clicked => { root.copy-rgb(); }
                    }

                    ColorCardItem {
                        label: "HSL";
                        value: root.hsl;
                        copy_clicked => { root.copy-hsl(); }
                    }

                    ColorCardItem {
                        label: "HSV";
                        value: root.hsv;
                        copy_clicked => { root.copy-hsv(); }
                    }
                }
            }
        }

        // Bottom Toast Banner (Deep Teal) - Glued to bottom edge
        if root.show-copied-toast: Rectangle {
            x: 0px;
            y: parent.height - 44px;
            width: 100%;
            height: 44px;
            background: #1f6473;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Rectangle {
                    width: 18px;
                    height: 18px;

                    Rectangle {
                        x: 2px;
                        y: 1px;
                        width: 9px;
                        height: 11px;
                        border-width: 1.5px;
                        border-color: #ffffff;
                        border-radius: 2px;
                        background: transparent;
                    }

                    Rectangle {
                        x: 5px;
                        y: 4px;
                        width: 9px;
                        height: 11px;
                        border-width: 1.5px;
                        border-color: #ffffff;
                        border-radius: 2px;
                        background: #1f6473;
                    }
                }

                Text {
                    text: "Copied to clipboard";
                    font-size: 14px;
                    font-weight: 500;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
        }
    }
}

