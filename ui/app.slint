component SidebarItem inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> is-active: true;
    callback clicked();

    height: 48px;
    background: is-active ? #282629 : (touch.has-hover ? #1f1e21 : transparent);

    animate background { duration: 150ms; }

    // Sharp left active accent line matching Antigravity
    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: root.is-active ? #b59ee6 : transparent;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        alignment: start;

        if root.icon != "": Text {
            text: root.icon;
            font-size: 18px;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: 15px;
            font-weight: root.is-active ? 600 : 500;
            color: root.is-active ? #f0eff1 : (touch.has-hover ? #ecebec : #a6a4a8);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "PowerToys";
    background: #141315; // Antigravity neutral obsidian black

    in-out property <int> selected-index: 0;
    callback close-requested();

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            spacing: 0px;

            // Sidebar
            Rectangle {
                width: 260px;
                background: #181719; // Antigravity sidebar dark neutral

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    // App Header
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-top: 8px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "⚡";
                            font-size: 22px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "PowerToys";
                            font-size: 20px;
                            font-weight: 700;
                            color: #f0eff1;
                            vertical-alignment: center;
                        }
                    }

                    // Separator
                    Rectangle {
                        height: 1px;
                        background: #252327;
                    }

                    // Navigation Category Label
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-top: 12px;
                        padding-bottom: 4px;
                        Text {
                            text: "FEATURES";
                            font-size: 11px;
                            font-weight: 700;
                            color: #8a888c;
                        }
                    }

                    // First feature: Colour Picker
                    SidebarItem {
                        text: "Colour Picker";
                        icon: "🎨";
                        is-active: root.selected-index == 0;
                        clicked => { root.selected-index = 0; }
                    }

                    Rectangle { vertical-stretch: 1; }

                    // Footer hint
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 8px;
                        Text {
                            text: "Press Esc to exit";
                            font-size: 12px;
                            color: #6d6b6e;
                        }
                    }
                }
            }

            // Divider Line
            Rectangle {
                width: 1px;
                background: #252327;
            }

            // Main Content Area
            Rectangle {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 36px;
                    spacing: 16px;

                    Text {
                        text: "Colour Picker";
                        font-size: 32px;
                        font-weight: 700;
                        color: #f0eff1;
                    }

                    Text {
                        text: "Quick and simple system-wide color picker utility.";
                        font-size: 15px;
                        color: #a6a4a8;
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
