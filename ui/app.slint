component HeroIllustration inherits Rectangle {
    width: 140px;
    height: 80px;
    border-radius: 6px;
    clip: true;
    background: @linear-gradient(135deg, #1f2a3a, #151a24);
    border-width: 1px;
    border-color: #2c384a;

    Rectangle {
        x: 0px;
        y: 40px;
        width: 140px;
        height: 40px;
        background: @linear-gradient(180deg, #25385255, #141b26);
    }

    // Mini PowerToys Picker Window floating inside
    Rectangle {
        x: 36px;
        y: 12px;
        width: 72px;
        height: 52px;
        border-radius: 4px;
        background: #1c1a1e;
        border-width: 1px;
        border-color: #38343e;

        // Mini header
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 9px;
            background: #252229;
            border-top-left-radius: 4px;
            border-top-right-radius: 4px;
        }

        // Mini color swatch on left
        Rectangle {
            x: 6px;
            y: 13px;
            width: 18px;
            height: 33px;
            border-radius: 2px;
            background: #b59ee6;
        }

        // Mini format lines
        VerticalLayout {
            x: 28px;
            y: 14px;
            width: 38px;
            spacing: 5px;

            Rectangle { width: 36px; height: 3px; border-radius: 1px; background: #5a5464; }
            Rectangle { width: 30px; height: 3px; border-radius: 1px; background: #433e4c; }
            Rectangle { width: 32px; height: 3px; border-radius: 1px; background: #433e4c; }
            Rectangle { width: 24px; height: 3px; border-radius: 1px; background: #433e4c; }
        }
    }

    // Mini Loupe / Dropper cursor
    Rectangle {
        x: 20px;
        y: 38px;
        width: 12px;
        height: 12px;
        background: transparent;

        Rectangle { x: 3px; y: 3px; width: 6px; height: 6px; border-radius: 3px; border-width: 1.5px; border-color: #ffffff; background: transparent; }
        Rectangle { x: 5px; y: 0px; width: 2px; height: 3px; background: #ffffff; }
        Rectangle { x: 5px; y: 9px; width: 2px; height: 3px; background: #ffffff; }
        Rectangle { x: 0px; y: 5px; width: 3px; height: 2px; background: #ffffff; }
        Rectangle { x: 9px; y: 5px; width: 3px; height: 2px; background: #ffffff; }
    }
}

component ColorFormatSettingRow inherits Rectangle {
    in property <string> format-name;
    in property <string> format-preview;
    in-out property <bool> is-enabled: true;
    callback toggled(bool);
    callback more-clicked();

    height: 52px;
    background: transparent;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.format-name;
                font-size: 14px;
                font-weight: 600;
                color: #f0eff1;
            }

            Text {
                text: root.format-preview;
                font-size: 12px;
                color: #8a888c;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            ToggleSwitch {
                checked: root.is-enabled;
                toggled(val) => {
                    root.is-enabled = val;
                    root.toggled(val);
                }
            }

            MoreOptionsButton {
                clicked => { root.more-clicked(); }
            }
        }
    }
}


export component MainWindow inherits Window {
    title: "PowerToys";
    background: #141315;
    min-width: 800px;
    min-height: 600px;

    in-out property <int> selected-index: 0;
    in-out property <string> shortcut-text: "SUPER + SHIFT + C";
    in-out property <string> current-hex: "#B59EE6";
    in-out property <string> current-hex-clean: "b59ee6";
    in-out property <string> color-name: "Lavender";
    in-out property <string> current-rgb: "rgb(181, 158, 230)";
    in-out property <string> current-hsl: "hsl(259, 58%, 76%)";
    in-out property <string> current-hsv: "hsv(259, 31%, 90%)";
    in-out property <string> current-cmyk: "cmyk(21%, 31%, 0%, 10%)";
    in-out property <color> current-color: #b59ee6;
    in-out property <string> status-text: "";
    in-out property <[HistoryColor]> history: [];

    in-out property <bool> is-color-picker-enabled: true;
    in-out property <string> activation-behavior: "Open editor";
    in-out property <string> default-color-format: "HEX";
    in-out property <bool> show-color-name: true;
    in-out property <bool> is-editing-shortcut: false;

    in-out property <bool> hex-format-enabled: true;
    in-out property <bool> rgb-format-enabled: true;
    in-out property <bool> hsl-format-enabled: true;
    in-out property <bool> hsv-format-enabled: true;
    in-out property <bool> cmyk-format-enabled: true;

    callback close-requested();
    callback pick-color-clicked();
    callback copy-hex-clicked(string);
    callback copy-rgb-clicked(string);
    callback copy-hsl-clicked(string);
    callback copy-cmyk-clicked(string);
    callback save-shortcut-clicked(string);
    callback swatch-selected(string);
    callback format-toggled(string, bool);
    callback behavior-changed(string);
    callback default-format-changed(string);
    callback enable-toggled(bool);
    callback show-name-toggled(bool);

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            spacing: 0px;

            // Sidebar (Fixed width)
            Rectangle {
                width: 250px;
                background: #181719;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    // App Header
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-top: 8px;
                        padding-bottom: 12px;
                        spacing: 12px;
                        alignment: center;

                        // Modern Vector Logo Mark
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: transparent;

                            Rectangle { x: 0px; y: 0px; width: 9px; height: 9px; border-radius: 2px; background: #0078d4; }
                            Rectangle { x: 11px; y: 0px; width: 9px; height: 9px; border-radius: 2px; background: #2b8396; }
                            Rectangle { x: 0px; y: 11px; width: 9px; height: 9px; border-radius: 2px; background: #b59ee6; }
                            Rectangle { x: 11px; y: 11px; width: 9px; height: 9px; border-radius: 2px; background: #50e3c2; }
                        }

                        Text {
                            text: "PowerToys";
                            font-size: 20px;
                            font-weight: 700;
                            color: #f0eff1;
                            vertical-alignment: center;
                        }
                    }

                    // Separator
                    Rectangle {
                        height: 1px;
                        background: #252327;
                    }

                    // Navigation Category Label
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-top: 12px;
                        padding-bottom: 4px;
                        Text {
                            text: "MODULES";
                            font-size: 11px;
                            font-weight: 700;
                            color: #8a888c;
                        }
                    }

                    // Module 0: Colour Picker
                    SidebarItem {
                        text: "Colour Picker";
                        is-active: root.selected-index == 0;
                        clicked => { root.selected-index = 0; }
                    }

                    Rectangle { vertical-stretch: 1; }

                    // Footer hint
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 8px;
                        Text {
                            text: "Press Esc to exit";
                            font-size: 12px;
                            color: #6d6b6e;
                        }
                    }
                }
            }

            // Divider Line
            Rectangle {
                width: 1px;
                background: #252327;
            }

            // Main Content Area with mathematically guaranteed right-side padding
            Rectangle {
                horizontal-stretch: 1;
                background: #141315;

                Flickable {
                    x: 36px;
                    y: 28px;
                    width: parent.width - 72px;
                    height: parent.height - 56px;
                    content-width: self.width;
                    content-height: content.preferred-height;

                    content := VerticalLayout {
                        width: parent.width;
                        spacing: 20px;
                        alignment: start;

                        // 1. Page Title Header
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Color Picker";
                                font-size: 28px;
                                font-weight: 700;
                                color: #f0eff1;
                            }
                        }

                        // 2. Hero Card (Thumbnail illustration on left, info & action on right)
                        Rectangle {
                            background: transparent;
                            height: 80px;

                            HorizontalLayout {
                                spacing: 20px;
                                alignment: start;

                                HeroIllustration { }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Text {
                                        text: "Quick and simple system-wide color picker.";
                                        font-size: 13px;
                                        color: #a6a4a8;
                                    }

                                    HorizontalLayout {
                                        spacing: 16px;
                                        alignment: center;

                                        Rectangle {
                                            height: 22px;
                                            background: transparent;
                                            Text {
                                                text: "Learn more about Color Picker";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #4cc2ff;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.status-text = "Official Microsoft PowerToys Color Picker active";
                                                }
                                            }
                                        }

                                        SharpButton {
                                            text: "Pick Color (Hyprpicker)";
                                            primary: true;
                                            clicked => { root.pick-color-clicked(); }
                                        }
                                    }
                                }
                            }
                        }

                        // 3. Enable Color Picker Card
                        Rectangle {
                            height: 64px;
                            background: #1c1a1e;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2c2832;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 16px;
                                    alignment: center;

                                    // Blue accent icon tile
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 4px;
                                        background: #0078d4;

                                        EyedropperIcon {
                                            x: 8px;
                                            y: 8px;
                                        }
                                    }

                                    Text {
                                        text: "Enable Color Picker";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #f0eff1;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;

                                    Text {
                                        text: root.is-color-picker-enabled ? "On" : "Off";
                                        font-size: 13px;
                                        color: #f0eff1;
                                        vertical-alignment: center;
                                    }

                                    ToggleSwitch {
                                        checked: root.is-color-picker-enabled;
                                        toggled(val) => {
                                            root.is-color-picker-enabled = val;
                                            root.enable-toggled(val);
                                        }
                                    }
                                }
                            }
                        }

                        // 4. Shortcut Section
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Shortcut";
                                font-size: 14px;
                                font-weight: 600;
                                color: #f0eff1;
                            }

                            // Group container for Shortcut settings
                            Rectangle {
                                background: #1c1a1e;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2c2832;

                                VerticalLayout {
                                    // Row 1: Activation shortcut
                                    Rectangle {
                                        height: 64px;
                                        background: transparent;

                                        HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 16px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 16px;
                                                alignment: center;

                                                KeyboardIcon { }

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;

                                                    Text {
                                                        text: "Activation shortcut";
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        color: #f0eff1;
                                                    }

                                                    Text {
                                                        text: "Customize the shortcut to activate this module";
                                                        font-size: 12px;
                                                        color: #8a888c;
                                                    }
                                                }
                                            }

                                            // Right side: Badges or Inline Editor
                                            if !root.is-editing-shortcut: HorizontalLayout {
                                                spacing: 6px;
                                                alignment: center;

                                                KeyBadge { is-win-key: true; }
                                                KeyBadge { key-text: "Shift"; }
                                                KeyBadge { key-text: "C"; }

                                                EditPencilButton {
                                                    clicked => { root.is-editing-shortcut = true; }
                                                }
                                            }

                                            if root.is-editing-shortcut: HorizontalLayout {
                                                spacing: 8px;
                                                alignment: center;

                                                shortcut-input := SharpInput {
                                                    width: 180px;
                                                    text: root.shortcut-text;
                                                    accepted(val) => {
                                                        root.is-editing-shortcut = false;
                                                        root.save-shortcut-clicked(val);
                                                    }
                                                }

                                                SharpButton {
                                                    text: "Save";
                                                    primary: true;
                                                    clicked => {
                                                        root.is-editing-shortcut = false;
                                                        root.save-shortcut-clicked(shortcut-input.text);
                                                    }
                                                }

                                                SharpButton {
                                                    text: "Cancel";
                                                    primary: false;
                                                    clicked => {
                                                        root.is-editing-shortcut = false;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Divider Line
                                    Rectangle { height: 1px; background: #26232b; }

                                    // Row 2: Activation behavior
                                    Rectangle {
                                        height: 52px;
                                        background: transparent;

                                        HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 16px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 16px;
                                                alignment: center;

                                                MonitorIcon { }

                                                Text {
                                                    text: "Activation behavior";
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: #f0eff1;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            DropdownButton {
                                                text: root.activation-behavior;
                                                clicked => {
                                                    if root.activation-behavior == "Open editor" {
                                                        root.activation-behavior = "Pick a color and open editor";
                                                    } else if root.activation-behavior == "Pick a color and open editor" {
                                                        root.activation-behavior = "Only pick a color";
                                                    } else {
                                                        root.activation-behavior = "Open editor";
                                                    }
                                                    root.behavior-changed(root.activation-behavior);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 5. Picker behavior Section
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Picker behavior";
                                font-size: 14px;
                                font-weight: 600;
                                color: #f0eff1;
                            }

                            // Group container for Picker behavior
                            Rectangle {
                                background: #1c1a1e;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2c2832;

                                VerticalLayout {
                                    // Row 1: Default color format
                                    Rectangle {
                                        height: 58px;
                                        background: transparent;

                                        HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 16px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 16px;
                                                alignment: center;

                                                ClipboardIcon { }

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;

                                                    Text {
                                                        text: "Default color format";
                                                        font-size: 14px;
                                                        font-weight: 600;
                                                        color: #f0eff1;
                                                    }

                                                    Text {
                                                        text: "This format will be copied to your clipboard";
                                                        font-size: 12px;
                                                        color: #8a888c;
                                                    }
                                                }
                                            }

                                            DropdownButton {
                                                text: "HEX - " + root.current-hex-clean;
                                                clicked => {
                                                    if root.default-color-format == "HEX" {
                                                        root.default-color-format = "RGB";
                                                    } else if root.default-color-format == "RGB" {
                                                        root.default-color-format = "HSL";
                                                    } else {
                                                        root.default-color-format = "HEX";
                                                    }
                                                    root.default-format-changed(root.default-color-format);
                                                }
                                            }
                                        }
                                    }

                                    // Divider Line
                                    Rectangle { height: 1px; background: #26232b; }

                                    // Row 2: Show color name
                                    Rectangle {
                                        height: 54px;
                                        background: transparent;

                                        HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 16px;
                                            alignment: space-between;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;

                                                Text {
                                                    text: "Show color name";
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    color: #f0eff1;
                                                }

                                                Text {
                                                    text: "This will show the name of the color when picking a color";
                                                    font-size: 12px;
                                                    color: #8a888c;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 12px;
                                                alignment: center;

                                                Text {
                                                    text: root.show-color-name ? "On" : "Off";
                                                    font-size: 13px;
                                                    color: #f0eff1;
                                                    vertical-alignment: center;
                                                }

                                                ToggleSwitch {
                                                    checked: root.show-color-name;
                                                    toggled(val) => {
                                                        root.show-color-name = val;
                                                        root.show-name-toggled(val);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 6. Color formats Section
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Color formats";
                                font-size: 14px;
                                font-weight: 600;
                                color: #f0eff1;
                            }

                            // Header card: Color formats title + "Add new format" button
                            Rectangle {
                                height: 58px;
                                background: #1c1a1e;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2c2832;

                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 16px;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: 16px;
                                        alignment: center;

                                        FormatListIcon { }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: "Color formats";
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: #f0eff1;
                                            }

                                            Text {
                                                text: "Configure the color formats (edit, delete, hide, reorder them)";
                                                font-size: 12px;
                                                color: #8a888c;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 32px;
                                        background: add_btn_touch.has-hover ? #1a88e4 : #0078d4;
                                        border-radius: 4px;

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: center;

                                            Text {
                                                text: "Add new format";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                            }
                                        }

                                        add_btn_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.status-text = "Standard formats loaded: HEX, RGB, HSL, HSV, CMYK";
                                            }
                                        }
                                    }
                                }
                            }

                            // Stacked individual format rows
                            Rectangle {
                                background: #1c1a1e;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #2c2832;

                                VerticalLayout {
                                    ColorFormatSettingRow {
                                        format-name: "HEX";
                                        format-preview: root.current-hex-clean;
                                        is-enabled: root.hex-format-enabled;
                                        toggled(val) => {
                                            root.hex-format-enabled = val;
                                            root.format-toggled("HEX", val);
                                        }
                                        more-clicked => {
                                            root.copy-hex-clicked(root.current-hex);
                                        }
                                    }

                                    Rectangle { height: 1px; background: #26232b; }

                                    ColorFormatSettingRow {
                                        format-name: "RGB";
                                        format-preview: root.current-rgb;
                                        is-enabled: root.rgb-format-enabled;
                                        toggled(val) => {
                                            root.rgb-format-enabled = val;
                                            root.format-toggled("RGB", val);
                                        }
                                        more-clicked => {
                                            root.copy-rgb-clicked(root.current-rgb);
                                        }
                                    }

                                    Rectangle { height: 1px; background: #26232b; }

                                    ColorFormatSettingRow {
                                        format-name: "HSL";
                                        format-preview: root.current-hsl;
                                        is-enabled: root.hsl-format-enabled;
                                        toggled(val) => {
                                            root.hsl-format-enabled = val;
                                            root.format-toggled("HSL", val);
                                        }
                                        more-clicked => {
                                            root.copy-hsl-clicked(root.current-hsl);
                                        }
                                    }

                                    Rectangle { height: 1px; background: #26232b; }

                                    ColorFormatSettingRow {
                                        format-name: "HSV";
                                        format-preview: root.current-hsv;
                                        is-enabled: root.hsv-format-enabled;
                                        toggled(val) => {
                                            root.hsv-format-enabled = val;
                                            root.format-toggled("HSV", val);
                                        }
                                        more-clicked => {
                                            root.copy-hex-clicked(root.current-hex);
                                        }
                                    }

                                    Rectangle { height: 1px; background: #26232b; }

                                    ColorFormatSettingRow {
                                        format-name: "CMYK";
                                        format-preview: root.current-cmyk;
                                        is-enabled: root.cmyk-format-enabled;
                                        toggled(val) => {
                                            root.cmyk-format-enabled = val;
                                            root.format-toggled("CMYK", val);
                                        }
                                        more-clicked => {
                                            root.copy-cmyk-clicked(root.current-cmyk);
                                        }
                                    }
                                }
                            }
                        }

                        // 7. Recent Color History Section
                        Rectangle {
                            background: #1c1a1e;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2c2832;

                            VerticalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                spacing: 10px;

                                Text {
                                    text: "Color History";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: #f0eff1;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    for item in root.history: ColorBox {
                                        fill-color: item.col;
                                        hex-value: item.hex;
                                        clicked(hex) => { root.swatch-selected(hex); }
                                    }
                                }
                            }
                        }

                        // 8. Status / Feedback Notification Bar
                        if root.status-text != "": Rectangle {
                            background: #1c261e;
                            border-width: 1px;
                            border-color: #2e4a33;
                            border-radius: 4px;
                            height: 36px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: start;

                                Text {
                                    text: root.status-text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: #a6e3a1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component ColorCardItem inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    callback copy_clicked();
    callback card_clicked();

    height: 40px;
    background: touch.has-hover ? #28242c : #201d24;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover ? #3d3744 : #2c2832;

    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        alignment: stretch;

        // Label
        Text {
            width: 48px;
            text: root.label;
            font-size: 13px;
            font-weight: 700;
            color: #8a888c;
            vertical-alignment: center;
        }

        // Value
        Text {
            text: root.value;
            font-size: 14px;
            font-weight: 600;
            color: #f0eff1;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        // Copy Icon Button (Fluent overlapping rectangles)
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 4px;
            background: btn_touch.has-hover ? #2e2a34 : transparent;

            Rectangle {
                x: 7px;
                y: 6px;
                width: 10px;
                height: 12px;
                border-width: 1.5px;
                border-color: #8a888c;
                border-radius: 2px;
                background: transparent;
            }

            Rectangle {
                x: 10px;
                y: 9px;
                width: 10px;
                height: 12px;
                border-width: 1.5px;
                border-color: #8a888c;
                border-radius: 2px;
                background: #201d24;
            }

            btn_touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.copy_clicked(); }
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.card_clicked(); }
    }
}

component HistoryDot inherits Rectangle {
    in property <color> fill-color;
    in property <bool> is-active: false;
    callback clicked();

    width: 22px;
    height: 22px;

    // Outer active ring (uses Antigravity purple accent #b59ee6 for active selection)
    if root.is-active: Rectangle {
        x: 0px;
        y: 0px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        border-width: 2px;
        border-color: #b59ee6;
        background: transparent;
    }

    // Inner circle
    Rectangle {
        x: 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.fill-color;
        border-width: 1px;
        border-color: #ffffff18;
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ShadeCell inherits Rectangle {
    in property <color> fill-color;
    in property <bool> is-selected: false;
    callback clicked();

    background: root.fill-color;

    // Subtle hover state
    if touch.has-hover && !root.is-selected: Rectangle {
        width: 100%;
        height: 100%;
        background: #ffffff25;
        border-width: 1px;
        border-color: #ffffff66;
    }

    // High-contrast active selection border
    if root.is-selected: Rectangle {
        width: 100%;
        height: 100%;
        border-width: 2px;
        border-color: #ffffff;
        background: transparent;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ShadeStrip inherits Rectangle {
    in property <color> s1;
    in property <color> s2;
    in property <color> s3;
    in property <color> s4;
    in property <color> s5;
    in property <int> selected-index: 2;
    callback shade_clicked(int);

    width: 20px;
    height: 184px;
    border-radius: 4px;
    clip: true;
    border-width: 1px;
    border-color: #38343e;

    VerticalLayout {
        spacing: 0px;
        ShadeCell {
            vertical-stretch: 1;
            fill-color: root.s1;
            is-selected: root.selected-index == 0;
            clicked => { root.shade_clicked(0); }
        }
        ShadeCell {
            vertical-stretch: 1;
            fill-color: root.s2;
            is-selected: root.selected-index == 1;
            clicked => { root.shade_clicked(1); }
        }
        ShadeCell {
            vertical-stretch: 1;
            fill-color: root.s3;
            is-selected: root.selected-index == 2;
            clicked => { root.shade_clicked(2); }
        }
        ShadeCell {
            vertical-stretch: 1;
            fill-color: root.s4;
            is-selected: root.selected-index == 3;
            clicked => { root.shade_clicked(3); }
        }
        ShadeCell {
            vertical-stretch: 1;
            fill-color: root.s5;
            is-selected: root.selected-index == 4;
            clicked => { root.shade_clicked(4); }
        }
    }
}

export component PickerPopupWindow inherits Window {
    title: "Color Picker";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: 440px;
    height: 350px;

    in-out property <string> hex: "9cb687";
    in-out property <string> rgb: "rgb(156, 182, 135)";
    in-out property <string> hsl: "hsl(93, 24%, 62%)";
    in-out property <string> hsv: "hsv(93, 26%, 71%)";
    in-out property <color> current-color: #9cb687;
    in-out property <[HistoryColor]> history: [];
    in-out property <[color]> shades: [#b8cfab, #abc39c, #9cb687, #819b6e, #677e55];
    in-out property <int> selected-shade-index: 2;
    in-out property <bool> show-copied-toast: true;
    in-out property <bool> show-editor: true;
    in-out property <float> edit-h: 0.14;
    in-out property <float> edit-s: 0.38;
    in-out property <float> edit-v: 0.49;
    in-out property <color> edit-hue-color: #ffcc00;
    in-out property <color> edit-sat-color: #a89433;
    in-out property <string> edit-r-text: "125";
    in-out property <string> edit-g-text: "117";
    in-out property <string> edit-b-text: "78";
    in-out property <string> edit-hex-text: "7d754e";

    callback close-requested();
    callback pick-requested();
    callback settings-requested();
    callback copy-hex();
    callback copy-rgb();
    callback copy-hsl();
    callback copy-hsv();
    callback select-swatch(string);
    callback select-shade(int);
    callback editor-slider-changed(float, float, float);
    callback editor-rgb-changed(string, string, string);
    callback editor-hex-changed(string);
    callback editor-select-clicked();
    callback editor-close-clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #18161a;
        border-radius: 10px;
        border-width: 1px;
        border-color: #2e2a33;
        clip: true;

        // Titlebar
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 36px;
            background: #18161a;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                alignment: stretch;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 16px;
                        height: 16px;
                        background: #0078d4;
                        border-radius: 3px;
                        y: 10px;

                        Rectangle {
                            x: 4px;
                            y: 4px;
                            width: 8px;
                            height: 8px;
                            border-radius: 1px;
                            background: #ffffff;
                        }
                    }

                    Text {
                        text: "Color Picker";
                        font-size: 13px;
                        font-weight: 600;
                        color: #f0eff1;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    width: 26px;
                    height: 26px;
                    y: 5px;
                    border-radius: 4px;
                    background: close_touch.has-hover ? #2e2a33 : transparent;

                    Text {
                        text: "X";
                        font-size: 11px;
                        font-weight: 600;
                        color: #8a888c;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close_touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.close-requested(); }
                    }
                }
            }
        }

        // Toolbar
        Rectangle {
            x: 0px;
            y: 36px;
            width: 100%;
            height: 44px;
            background: #18161a;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: center;

                // Pick Button
                Rectangle {
                    width: 76px;
                    height: 30px;
                    background: pick_touch.has-hover ? #2f2b34 : #242127;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #38343e;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 2px;
                            background: #b59ee6;
                        }

                        Text {
                            text: "Pick";
                            font-size: 13px;
                            font-weight: 600;
                            color: #f0eff1;
                            vertical-alignment: center;
                        }
                    }

                    pick_touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.pick-requested(); }
                    }
                }

                // Adjust / Tune button
                Rectangle {
                    width: 32px;
                    height: 30px;
                    background: tune_touch.has-hover ? #2f2b34 : #242127;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #38343e;

                    Rectangle {
                        x: 6px; y: 8px; width: 20px; height: 2px; background: #8a888c; border-radius: 1px;
                    }
                    Rectangle {
                        x: 10px; y: 6px; width: 4px; height: 6px; background: #b59ee6; border-radius: 1px;
                    }
                    Rectangle {
                        x: 6px; y: 14px; width: 20px; height: 2px; background: #8a888c; border-radius: 1px;
                    }
                    Rectangle {
                        x: 18px; y: 12px; width: 4px; height: 6px; background: #b59ee6; border-radius: 1px;
                    }
                    Rectangle {
                        x: 6px; y: 20px; width: 20px; height: 2px; background: #8a888c; border-radius: 1px;
                    }
                    Rectangle {
                        x: 12px; y: 18px; width: 4px; height: 6px; background: #b59ee6; border-radius: 1px;
                    }

                    tune_touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.show-editor = !root.show-editor; }
                    }
                }

                // History Dots Row
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    horizontal-stretch: 1;

                    for item[i] in root.history: HistoryDot {
                        fill-color: item.col;
                        is-active: i == 0;
                        clicked => { root.select-swatch(item.hex); }
                    }
                }

                // Settings Button (Vector 3-dots)
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 4px;
                    background: set_touch.has-hover ? #28242c : transparent;

                    HorizontalLayout {
                        spacing: 3px;
                        alignment: center;

                        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: #8a888c; }
                        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: #8a888c; }
                        Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: #8a888c; }
                    }

                    set_touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: pointer;
                        clicked => { root.settings-requested(); }
                    }
                }
            }
        }

        // Handle Bar below Toolbar
        Rectangle {
            x: 150px;
            y: 78px;
            width: 140px;
            height: 2px;
            border-radius: 1px;
            background: #38343e;
        }

        // Separator Line
        Rectangle {
            x: 0px;
            y: 84px;
            width: 100%;
            height: 1px;
            background: #27242a;
        }

        // Main Content: Shades + Format Cards
        Rectangle {
            x: 0px;
            y: 85px;
            width: 100%;
            height: 221px;
            background: #18161a;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 12px;
                alignment: stretch;

                ShadeStrip {
                    s1: root.shades[0];
                    s2: root.shades[1];
                    s3: root.shades[2];
                    s4: root.shades[3];
                    s5: root.shades[4];
                    selected-index: root.selected-shade-index;
                    shade_clicked(idx) => { root.select-shade(idx); }
                }

                VerticalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;

                    ColorCardItem {
                        label: "HEX";
                        value: root.hex;
                        card_clicked => { root.show-editor = true; }
                        copy_clicked => { root.copy-hex(); }
                    }

                    ColorCardItem {
                        label: "RGB";
                        value: root.rgb;
                        card_clicked => { root.show-editor = true; }
                        copy_clicked => { root.copy-rgb(); }
                    }

                    ColorCardItem {
                        label: "HSL";
                        value: root.hsl;
                        card_clicked => { root.show-editor = true; }
                        copy_clicked => { root.copy-hsl(); }
                    }

                    ColorCardItem {
                        label: "HSV";
                        value: root.hsv;
                        card_clicked => { root.show-editor = true; }
                        copy_clicked => { root.copy-hsv(); }
                    }
                }
            }
        }

        // Color Editor Flyout Dialog (Prompt matching user screenshot)
        if root.show-editor: ColorEditorCard {
            x: 52px;
            y: 40px;
            width: 372px;
            height: 262px;
            h-val: root.edit-h;
            s-val: root.edit-s;
            v-val: root.edit-v;
            hue-color: root.edit-hue-color;
            sat-color: root.edit-sat-color;
            r-text: root.edit-r-text;
            g-text: root.edit-g-text;
            b-text: root.edit-b-text;
            hex-text: root.edit-hex-text;
            slider-changed(h, s, v) => {
                root.editor-slider-changed(h, s, v);
            }
            rgb-changed(r, g, b) => {
                root.editor-rgb-changed(r, g, b);
            }
            hex-changed(h) => {
                root.editor-hex-changed(h);
            }
            select-clicked => {
                root.editor-select-clicked();
            }
            close-clicked => {
                root.show-editor = false;
                root.editor-close-clicked();
            }
        }

        // Bottom Toast Banner (Deep Teal) - Glued to bottom edge
        if root.show-copied-toast: Rectangle {
            x: 0px;
            y: parent.height - 44px;
            width: 100%;
            height: 44px;
            background: #1f6473;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Rectangle {
                    width: 18px;
                    height: 18px;

                    Rectangle {
                        x: 2px;
                        y: 1px;
                        width: 9px;
                        height: 11px;
                        border-width: 1.5px;
                        border-color: #ffffff;
                        border-radius: 2px;
                        background: transparent;
                    }

                    Rectangle {
                        x: 5px;
                        y: 4px;
                        width: 9px;
                        height: 11px;
                        border-width: 1.5px;
                        border-color: #ffffff;
                        border-radius: 2px;
                        background: #1f6473;
                    }
                }

                Text {
                    text: "Copied to clipboard";
                    font-size: 14px;
                    font-weight: 500;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
        }
    }
}

