export struct HistoryColor {
    hex: string,
    col: color,
}

component SidebarItem inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> is-active: true;
    callback clicked();

    height: 48px;
    background: is-active ? #282629 : (touch.has-hover ? #1f1e21 : transparent);

    animate background { duration: 150ms; }

    // Sharp left active accent line matching Antigravity
    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: root.is-active ? #b59ee6 : transparent;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        alignment: start;

        if root.icon != "": Text {
            text: root.icon;
            font-size: 18px;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: 15px;
            font-weight: root.is-active ? 600 : 500;
            color: root.is-active ? #f0eff1 : (touch.has-hover ? #ecebec : #a6a4a8);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SharpButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    callback clicked();

    height: 38px;
    background: primary ? (touch.has-hover ? #c4a7e7 : #b59ee6) : (touch.has-hover ? #2e2b30 : #232125);
    border-width: primary ? 0px : 1px;
    border-color: #38343c;

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.primary ? #141315 : #f0eff1;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ColorFormatRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    callback copy_clicked();

    height: 38px;
    background: #171518;
    border-width: 1px;
    border-color: #27242a;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 12px;
        alignment: stretch;

        // Label Column (Fixed width for tabular alignment)
        Text {
            width: 52px;
            text: root.label;
            font-size: 13px;
            font-weight: 700;
            color: #8a888c;
            vertical-alignment: center;
        }

        // Value Column (Starts at exact same X position)
        Text {
            text: root.value;
            font-size: 14px;
            font-weight: 600;
            color: #f0eff1;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Action Button Column (Uniform 105px width)
        SharpButton {
            width: 105px;
            text: "Copy " + root.label;
            primary: false;
            clicked => { root.copy_clicked(); }
        }
    }
}

component SharpInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    callback accepted(string);

    height: 38px;
    background: #1c1a1e;
    border-width: 1px;
    border-color: input.has-focus ? #b59ee6 : #38343c;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        input := TextInput {
            font-size: 14px;
            color: #f0eff1;
            selection-background-color: #b59ee6;
            selection-foreground-color: #141315;
            vertical-alignment: center;
            accepted => { root.accepted(self.text); }
        }
    }
}

component ColorBox inherits Rectangle {
    in property <color> fill-color;
    in property <string> hex-value;
    callback clicked(string);

    width: 44px;
    height: 44px;
    background: root.fill-color;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? #ffffff : #38343c;

    touch := TouchArea {
        clicked => { root.clicked(root.hex-value); }
    }
}

component FeatureCard inherits Rectangle {
    background: #1b191d;
    border-width: 1px;
    border-color: #2b282e;
}

export component MainWindow inherits Window {
    title: "PowerToys";
    background: #141315;
    min-width: 800px;
    min-height: 600px;

    in-out property <int> selected-index: 0;
    in-out property <string> shortcut-text: "SUPER + SHIFT + C";
    in-out property <string> current-hex: "#B59EE6";
    in-out property <string> current-rgb: "rgb(181, 158, 230)";
    in-out property <string> current-hsl: "hsl(259, 58%, 76%)";
    in-out property <string> current-cmyk: "cmyk(21%, 31%, 0%, 10%)";
    in-out property <color> current-color: #b59ee6;
    in-out property <string> status-text: "";
    in-out property <[HistoryColor]> history: [];

    callback close-requested();
    callback pick-color-clicked();
    callback copy-hex-clicked(string);
    callback copy-rgb-clicked(string);
    callback copy-hsl-clicked(string);
    callback copy-cmyk-clicked(string);
    callback save-shortcut-clicked(string);
    callback swatch-selected(string);

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            spacing: 0px;

            // Sidebar (Fixed width)
            Rectangle {
                width: 250px;
                background: #181719;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    // App Header
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-top: 8px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "⚡";
                            font-size: 22px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "PowerToys";
                            font-size: 20px;
                            font-weight: 700;
                            color: #f0eff1;
                            vertical-alignment: center;
                        }
                    }

                    // Separator
                    Rectangle {
                        height: 1px;
                        background: #252327;
                    }

                    // Navigation Category Label
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-top: 12px;
                        padding-bottom: 4px;
                        Text {
                            text: "MODULES";
                            font-size: 11px;
                            font-weight: 700;
                            color: #8a888c;
                        }
                    }

                    // Module 0: Colour Picker
                    SidebarItem {
                        text: "Colour Picker";
                        icon: "🎨";
                        is-active: root.selected-index == 0;
                        clicked => { root.selected-index = 0; }
                    }

                    Rectangle { vertical-stretch: 1; }

                    // Footer hint
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 8px;
                        Text {
                            text: "Press Esc to exit";
                            font-size: 12px;
                            color: #6d6b6e;
                        }
                    }
                }
            }

            // Divider Line
            Rectangle {
                width: 1px;
                background: #252327;
            }

            // Main Content Area with mathematically guaranteed right-side padding
            Rectangle {
                horizontal-stretch: 1;
                background: #141315;

                Flickable {
                    x: 36px;
                    y: 32px;
                    width: parent.width - 72px;
                    height: parent.height - 64px;
                    content-width: self.width;
                    content-height: content.preferred-height;

                    content := VerticalLayout {
                        width: parent.width;
                        spacing: 20px;
                        alignment: start;

                            // Header
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: "Colour Picker";
                                    font-size: 28px;
                                    font-weight: 700;
                                    color: #f0eff1;
                                }

                                Text {
                                    text: "System-wide pixel color inspection and clipboard utility.";
                                    font-size: 13px;
                                    color: #a6a4a8;
                                }
                            }

                            // Action Banner (Sharp Box)
                            FeatureCard {
                                height: 76px;
                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    spacing: 16px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "Pick Any Color On Screen";
                                            font-size: 15px;
                                            font-weight: 600;
                                            color: #f0eff1;
                                        }
                                        Text {
                                            text: "Magnifying loupe freezes screen and captures exact pixel color.";
                                            font-size: 12px;
                                            color: #8a888c;
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    SharpButton {
                                        text: "🎯 Pick Color (Hyprpicker)";
                                        primary: true;
                                        clicked => { root.pick-color-clicked(); }
                                    }
                                }
                            }

                            // Shortcut Configuration Section
                            FeatureCard {
                                VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 18px;
                                    padding-bottom: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "Global Activation Shortcut";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: #f0eff1;
                                    }

                                    Text {
                                        text: "Press this shortcut from anywhere in your desktop to trigger Hyprpicker.";
                                        font-size: 12px;
                                        color: #8a888c;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;

                                        shortcut-input := SharpInput {
                                            text: root.shortcut-text;
                                            horizontal-stretch: 1;
                                        }

                                        SharpButton {
                                            text: "Save & Apply Shortcut";
                                            primary: false;
                                            clicked => { root.save-shortcut-clicked(shortcut-input.text); }
                                        }
                                    }
                                }
                            }

                            // Active Color Inspector Section
                            FeatureCard {
                                VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 18px;
                                    padding-bottom: 18px;
                                    spacing: 14px;

                                    Text {
                                        text: "Active Color Inspector";
                                        font-size: 15px;
                                        font-weight: 600;
                                        color: #f0eff1;
                                    }

                                    HorizontalLayout {
                                        spacing: 20px;
                                        alignment: stretch;

                                        // Large Color Swatch
                                        Rectangle {
                                            width: 120px;
                                            height: 176px;
                                            background: root.current-color;
                                            border-width: 1px;
                                            border-color: #38343c;
                                        }

                                        // Format Rows Column
                                        VerticalLayout {
                                            spacing: 8px;
                                            horizontal-stretch: 1;

                                            ColorFormatRow {
                                                label: "HEX";
                                                value: root.current-hex;
                                                copy_clicked => { root.copy-hex-clicked(root.current-hex); }
                                            }

                                            ColorFormatRow {
                                                label: "RGB";
                                                value: root.current-rgb;
                                                copy_clicked => { root.copy-rgb-clicked(root.current-rgb); }
                                            }

                                            ColorFormatRow {
                                                label: "HSL";
                                                value: root.current-hsl;
                                                copy_clicked => { root.copy-hsl-clicked(root.current-hsl); }
                                            }

                                            ColorFormatRow {
                                                label: "CMYK";
                                                value: root.current-cmyk;
                                                copy_clicked => { root.copy-cmyk-clicked(root.current-cmyk); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Dynamic Color History Section
                            FeatureCard {
                                VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 18px;
                                    padding-bottom: 18px;
                                    spacing: 12px;

                                    Text {
                                        text: "Color History";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #f0eff1;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        for item in root.history: ColorBox {
                                            fill-color: item.col;
                                            hex-value: item.hex;
                                            clicked(hex) => { root.swatch-selected(hex); }
                                        }
                                    }
                                }
                            }

                            // Status / Feedback message
                            if root.status-text != "": Rectangle {
                                background: #1c261e;
                                border-width: 1px;
                                border-color: #2e4a33;
                                height: 36px;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: start;

                                    Text {
                                        text: root.status-text;
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: #a6e3a1;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

